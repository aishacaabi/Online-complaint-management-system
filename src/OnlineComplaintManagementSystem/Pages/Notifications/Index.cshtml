@page
@using OnlineComplaintManagementSystem.Helpers
@model OnlineComplaintManagementSystem.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="section-title mb-0"><i class="bi bi-bell me-2"></i>Notifications</h4>
    <form method="post" asp-page-handler="MarkAllRead">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Mark All as Read</button>
    </form>
</div>

<div class="card card-panel">
    @if (!Model.Notifications.Any())
    {
        <div class="p-4 text-center text-muted">You have no notifications.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var n in Model.Notifications)
            {
                <li class="list-group-item @(n.IsRead ? "" : "bg-light")">
                    <div class="d-flex gap-3">
                        <i class="bi @n.Type.IconClass() fs-5 text-primary"></i>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <strong>@n.Title</strong>
                                <span class="text-muted small">@n.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <div class="text-muted small">@n.Message</div>
                            @if (n.ComplaintId is not null)
                            {
                                <a asp-page="/Notifications/Index" asp-route-openId="@n.Id" class="small">View complaint &rarr;</a>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>
