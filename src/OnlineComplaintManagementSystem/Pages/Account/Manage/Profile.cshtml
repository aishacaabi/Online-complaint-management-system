@page
@model OnlineComplaintManagementSystem.Pages.Account.Manage.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="section-title mb-0"><i class="bi bi-person me-2"></i>My Profile</h4>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-panel p-4">
            <div asp-validation-summary="All" class="alert alert-danger d-none-empty"></div>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label"></label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.Email" disabled />
                    <div class="form-text">Email cannot be changed. Contact the administrator if this needs to be updated.</div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.PhoneNumber" class="form-label"></label>
                        <input asp-for="Input.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Address" class="form-label"></label>
                        <input asp-for="Input.Address" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save Changes</button>
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-panel p-4 mb-3 text-center">
            <h6 class="section-title mb-3">Profile Photo</h6>
            @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
            {
                <img src="@Model.ProfilePhotoPath" alt="Profile photo" class="rounded-circle mb-3 mx-auto" style="width:120px;height:120px;object-fit:cover;" />
            }
            else
            {
                <i class="bi bi-person-circle text-secondary mb-3" style="font-size:120px;"></i>
            }
            <form method="post" asp-page-handler="UploadPhoto" enctype="multipart/form-data" class="mb-2">
                <input type="file" name="photoFile" class="form-control form-control-sm mb-2" accept="image/png,image/jpeg,image/gif" required />
                <button type="submit" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-upload me-1"></i>Upload Photo</button>
            </form>
            @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
            {
                <form method="post" asp-page-handler="RemovePhoto">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-trash me-1"></i>Remove Photo</button>
                </form>
            }
            <div class="form-text mt-2">JPG, PNG, or GIF. Max 3 MB.</div>
        </div>
        <div class="card card-panel p-4">
            <h6 class="section-title">Account Details</h6>
            <dl class="row mb-0 small">
                <dt class="col-6 text-muted">Role(s)</dt>
                <dd class="col-6">@string.Join(", ", Model.Roles)</dd>
                @if (Model.DepartmentName is not null)
                {
                    <dt class="col-6 text-muted">Department</dt>
                    <dd class="col-6">@Model.DepartmentName</dd>
                }
                <dt class="col-6 text-muted">Member Since</dt>
                <dd class="col-6">@Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")</dd>
            </dl>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
