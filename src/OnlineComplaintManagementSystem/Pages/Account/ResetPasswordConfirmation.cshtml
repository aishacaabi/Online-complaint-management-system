@page
@{
    ViewData["Title"] = "Password Reset Complete";
}

<div class="container login-shell">
    <div class="row justify-content-center w-100">
        <div class="col-md-7 col-lg-6">
            <div class="card auth-card p-4 p-md-5 text-center">
                <i class="bi bi-check-circle display-4 text-success mb-3"></i>
                <h3 class="section-title">Password Reset Successful</h3>
                <p class="text-muted">Your password has been changed. You can now sign in with your new password.</p>
                <a asp-page="/Account/Login" class="btn btn-primary mt-2">Go to Login</a>
            </div>
        </div>
    </div>
</div>
