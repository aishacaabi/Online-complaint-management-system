@page
@model OnlineComplaintManagementSystem.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container login-shell">
    <div class="row justify-content-center w-100">
        <div class="col-md-7 col-lg-6">
            <div class="card auth-card p-4 p-md-5 text-center">
                <i class="bi bi-envelope-check display-4 text-primary mb-3"></i>
                <h3 class="section-title">Check Your Email</h3>
                <p class="text-muted">If an account exists with that email address, password reset instructions have been sent.</p>

                @if (!string.IsNullOrEmpty(Model.SimulatedResetLink))
                {
                    <div class="alert alert-warning text-start mt-3">
                        <strong><i class="bi bi-info-circle me-1"></i>Demo Mode:</strong> This project has no outbound email server configured.
                        In a production deployment this link would be delivered by email; for demonstration purposes only, it is shown here so you can complete the flow:
                        <div class="mt-2">
                            <a href="@Model.SimulatedResetLink" class="text-break">@Model.SimulatedResetLink</a>
                        </div>
                    </div>
                }

                <a asp-page="/Account/Login" class="btn btn-primary mt-3">Back to Login</a>
            </div>
        </div>
    </div>
</div>
