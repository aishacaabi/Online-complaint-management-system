@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold mb-3">Online Complaint Management System</h1>
                <p class="lead opacity-90 mb-4">
                    A centralized platform to submit, track, and resolve complaints efficiently.
                    Get transparent updates from submission to resolution.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-page="/Account/Register" class="btn btn-light btn-lg px-4"><i class="bi bi-file-earmark-plus me-2"></i>Submit a Complaint</a>
                    <a asp-page="/Complaints/Track" class="btn btn-outline-light btn-lg px-4"><i class="bi bi-search me-2"></i>Track a Complaint</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <i class="bi bi-clipboard2-check" style="font-size: 14rem; opacity: 0.85;"></i>
            </div>
        </div>
    </div>
</section>

<div class="container my-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="p-4 h-100">
                <div class="feature-icon mb-3"><i class="bi bi-send-check"></i></div>
                <h5 class="section-title">Submit Easily</h5>
                <p class="text-muted">Log a complaint in minutes with category, department, priority, and supporting documents.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 h-100">
                <div class="feature-icon mb-3"><i class="bi bi-signpost-split"></i></div>
                <h5 class="section-title">Track Progress</h5>
                <p class="text-muted">Follow your complaint through a visual timeline from submission to resolution.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 h-100">
                <div class="feature-icon mb-3"><i class="bi bi-chat-square-text"></i></div>
                <h5 class="section-title">Stay Informed</h5>
                <p class="text-muted">Receive notifications and communicate directly with the assigned complaint officer.</p>
            </div>
        </div>
    </div>
</div>
