@model OnlineComplaintManagementSystem.ViewModels.PaginationInfo
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @{
                var routeValues = new Dictionary<string, string?>(Model.RouteValues);
            }
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                @{ routeValues["page"] = (Model.CurrentPage - 1).ToString(); }
                <a class="page-link" asp-all-route-data="routeValues">Previous</a>
            </li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                var pageRoute = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = i.ToString() };
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-all-route-data="pageRoute">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                @{ routeValues["page"] = (Model.CurrentPage + 1).ToString(); }
                <a class="page-link" asp-all-route-data="routeValues">Next</a>
            </li>
        </ul>
    </nav>
}
