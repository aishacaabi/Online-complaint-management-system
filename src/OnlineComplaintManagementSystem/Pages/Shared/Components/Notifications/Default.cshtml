@using OnlineComplaintManagementSystem.Helpers
@model OnlineComplaintManagementSystem.ViewComponents.NotificationsPanelModel

<div class="dropdown">
    <button class="btn btn-sm btn-icon text-white position-relative" type="button" data-bs-toggle="dropdown" aria-label="Notifications">
        <i class="bi bi-bell fs-5"></i>
        @if (Model.UnreadCount > 0)
        {
            <span class="badge rounded-pill bg-danger notif-badge">@(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount.ToString())</span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end shadow-sm notif-dropdown p-0">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <span class="fw-semibold">Notifications</span>
            <a asp-page="/Notifications/Index" class="small">View all</a>
        </div>
        @if (Model.Recent.Count == 0)
        {
            <div class="p-3 text-muted small text-center">No notifications yet.</div>
        }
        else
        {
            foreach (var n in Model.Recent)
            {
                <a class="dropdown-item notif-item @(n.IsRead ? "" : "unread")" asp-page="/Notifications/Index" asp-route-openId="@n.Id">
                    <div class="d-flex gap-2">
                        <i class="bi @n.Type.IconClass() mt-1"></i>
                        <div>
                            <div class="fw-semibold small">@n.Title</div>
                            <div class="small text-muted">@n.Message</div>
                            <div class="small text-muted">@n.CreatedDate.ToLocalTime().ToString("MMM dd, HH:mm")</div>
                        </div>
                    </div>
                </a>
            }
        }
    </div>
</div>
