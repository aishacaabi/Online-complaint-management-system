@page
@using OnlineComplaintManagementSystem.Helpers
@using System.Text.Json
@model OnlineComplaintManagementSystem.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h4 class="section-title mb-4">Administrator Dashboard</h4>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Complaints/Index" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#1a4d8f;"><i class="bi bi-card-list"></i></div>
            <div><div class="stat-value">@Model.TotalComplaints</div><div class="stat-label">Total Complaints</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Complaints/Index" asp-route-fromDate="@Model.WeekAgoDate.ToString("yyyy-MM-dd")" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#2f7dd6;"><i class="bi bi-stars"></i></div>
            <div><div class="stat-value">@Model.NewThisWeek</div><div class="stat-label">New This Week</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Complaints/Index" asp-route-statusGroup="pending" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#e0a800;"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="stat-value">@Model.PendingCount</div><div class="stat-label">Pending</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Complaints/Index" asp-route-status="Investigating" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#0d6efd;"><i class="bi bi-search"></i></div>
            <div><div class="stat-value">@Model.InvestigatingCount</div><div class="stat-label">Under Investigation</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Complaints/Index" asp-route-statusGroup="resolved" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#1e7e34;"><i class="bi bi-check-circle"></i></div>
            <div><div class="stat-value">@Model.ResolvedCount</div><div class="stat-label">Resolved</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Complaints/Index" asp-route-status="Closed" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#343a40;"><i class="bi bi-lock"></i></div>
            <div><div class="stat-value">@Model.ClosedCount</div><div class="stat-label">Closed</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Complaints/Index" asp-route-status="Escalated" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#c0392b;"><i class="bi bi-exclamation-triangle"></i></div>
            <div><div class="stat-value">@Model.EscalatedCount</div><div class="stat-label">Escalated</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Users/Index" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#6f42c1;"><i class="bi bi-people"></i></div>
            <div><div class="stat-value">@Model.TotalUsers</div><div class="stat-label">Total Users</div></div>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Departments/Index" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#20c997;"><i class="bi bi-building"></i></div>
            <div><div class="stat-value">@Model.TotalDepartments</div><div class="stat-label">Departments</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Admin/Reports/Index" asp-route-reportTitle="Complaint Resolution Time Report" asp-route-status="Resolved" class="stat-card d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#fd7e14;"><i class="bi bi-clock"></i></div>
            <div><div class="stat-value">@Model.AverageResolutionDays.ToString("N1")</div><div class="stat-label">Avg. Resolution (days)</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-card-static d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#ffc107;"><i class="bi bi-star-fill"></i></div>
            <div><div class="stat-value">@Model.AverageFeedbackRating.ToString("N1") / 5</div><div class="stat-label">Avg. Feedback Rating (@Model.FeedbackCount)</div></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card card-panel p-3">
            <h6 class="section-title">Complaints by Status</h6>
            <canvas id="statusChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-panel p-3">
            <h6 class="section-title">Monthly Complaint Trends</h6>
            <canvas id="trendChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-panel p-3">
            <h6 class="section-title">Complaints by Category</h6>
            <canvas id="categoryChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-panel p-3">
            <h6 class="section-title">Complaints by Department</h6>
            <canvas id="departmentChart" height="220"></canvas>
        </div>
    </div>
</div>

<div class="card card-panel">
    <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
        <h6 class="mb-0 section-title">Recent Complaints</h6>
        <a asp-page="/Admin/Complaints/Index" class="small">View all</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Reference</th><th>Title</th><th>Category</th><th>Department</th><th>Status</th><th>Submitted</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model.RecentComplaints)
                {
                    <tr>
                        <td class="ref-code">@c.ReferenceNumber</td>
                        <td>@c.Title</td>
                        <td>@c.Category?.Name</td>
                        <td>@c.Department?.Name</td>
                        <td><span class="badge @c.Status.BadgeClass()">@c.Status.DisplayName()</span></td>
                        <td>@c.SubmittedDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                        <td><a asp-page="/Admin/Complaints/Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const statusData = @Html.Raw(JsonSerializer.Serialize(Model.ByStatus));
        const categoryData = @Html.Raw(JsonSerializer.Serialize(Model.ByCategory));
        const departmentData = @Html.Raw(JsonSerializer.Serialize(Model.ByDepartment));
        const trendLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyTrend.Select(t => t.Month)));
        const trendValues = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyTrend.Select(t => t.Count)));

        const palette = ['#1a4d8f', '#2f7dd6', '#20c997', '#ffc107', '#fd7e14', '#c0392b', '#6f42c1', '#343a40', '#0d6efd'];

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: { labels: Object.keys(statusData), datasets: [{ data: Object.values(statusData), backgroundColor: palette }] },
            options: { plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } } }
        });

        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: { labels: trendLabels, datasets: [{ label: 'Complaints', data: trendValues, borderColor: '#1a4d8f', backgroundColor: 'rgba(26,77,143,0.15)', fill: true, tension: 0.3 }] },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: { labels: Object.keys(categoryData), datasets: [{ label: 'Complaints', data: Object.values(categoryData), backgroundColor: '#2f7dd6' }] },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        new Chart(document.getElementById('departmentChart'), {
            type: 'bar',
            data: { labels: Object.keys(departmentData), datasets: [{ label: 'Complaints', data: Object.values(departmentData), backgroundColor: '#20c997' }] },
            options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
    </script>
}
