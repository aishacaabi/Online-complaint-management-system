@page
@model OnlineComplaintManagementSystem.Pages.Complainant.Complaints.SubmitModel
@{
    ViewData["Title"] = "Submit Complaint";
}

<h4 class="section-title mb-3"><i class="bi bi-file-earmark-plus me-2"></i>Submit a New Complaint</h4>

<div class="card card-panel p-4">
    <div asp-validation-summary="All" class="alert alert-danger d-none-empty"></div>
    <form method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" placeholder="Brief summary of your complaint" />
            <span asp-validation-for="Input.Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="5" placeholder="Describe your complaint in detail"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Input.CategoryId" class="form-label"></label>
                <select asp-for="Input.CategoryId" class="form-select">
                    <option value="">Select category...</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
                <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.DepartmentId" class="form-label"></label>
                <select asp-for="Input.DepartmentId" class="form-select">
                    <option value="">Select department...</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
                <span asp-validation-for="Input.DepartmentId" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.Priority" class="form-label"></label>
                <select asp-for="Input.Priority" class="form-select">
                    @foreach (OnlineComplaintManagementSystem.Models.ComplaintPriority p in Enum.GetValues(typeof(OnlineComplaintManagementSystem.Models.ComplaintPriority)))
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Location" class="form-label"></label>
            <input asp-for="Input.Location" class="form-control" placeholder="e.g. Building A, Room 204" />
        </div>

        <hr />
        <h6 class="section-title mb-3">Contact Information</h6>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Input.ContactName" class="form-label"></label>
                <input asp-for="Input.ContactName" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.ContactPhone" class="form-label"></label>
                <input asp-for="Input.ContactPhone" class="form-control" />
                <span asp-validation-for="Input.ContactPhone" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Input.ContactEmail" class="form-label"></label>
                <input asp-for="Input.ContactEmail" class="form-control" />
                <span asp-validation-for="Input.ContactEmail" class="text-danger small"></span>
                <div class="form-text">Used to verify your identity when tracking this complaint publicly.</div>
            </div>
        </div>

        <hr />
        <div class="mb-3">
            <label class="form-label">Supporting Attachments</label>
            <input type="file" name="Input.Attachments" class="form-control" multiple />
            <div class="form-text">Allowed: jpg, png, gif, pdf, doc(x), xls(x), txt. Max 10 MB per file.</div>
        </div>

        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-send me-1"></i>Submit Complaint</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
